{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd world && npm install && cd ../flybook/web && npm install && cd ../../mine/wallet && npm ci",
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": ".vercel-out",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/sim",
      "destination": "/simulation",
      "permanent": false
    },
    {
      "source": "/world",
      "destination": "/simulation",
      "permanent": false
    },
    {
      "source": "/flybook",
      "destination": "/flybook/",
      "permanent": false
    },
    {
      "source": "/radio",
      "destination": "/radio/",
      "permanent": false
    },
    {
      "source": "/roulette",
      "destination": "/roulette/",
      "permanent": false
    },
    {
      "source": "/flinder",
      "destination": "/flinder/",
      "permanent": false
    },
    {
      "source": "/traderflies",
      "destination": "/traderflies/",
      "permanent": false
    },
    {
      "source": "/mint",
      "destination": "/traderflies/",
      "permanent": false
    },
    {
      "source": "/compute",
      "destination": "/compute/",
      "permanent": false
    },
    {
      "source": "/shop",
      "destination": "https://shop.flyaiworld.com",
      "permanent": false
    },
    {
      "source": "/merch",
      "destination": "/shop",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/roulette/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/traderflies/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/flinder/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/radio/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/simulation/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/simulation/(connectome|models)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/flybook/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
