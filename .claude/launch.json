{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pong",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "pong",
        "run",
        "dev"
      ],
      "port": 3210
    },
    {
      "name": "flyborne",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "flyborne",
        "run",
        "dev"
      ],
      "port": 5191
    },
    {
      "name": "flyborne-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "flyborne",
        "run",
        "server"
      ],
      "port": 8791
    },
    {
      "name": "docs",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        ".claude/serve-docs.py",
        "8090"
      ],
      "port": 8090
    },
    {
      "name": "traderflies",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set DOCS_URL=http://127.0.0.1:8090&& set VITE_BASE=/traderflies/&& cd flytrade\\web && npx vite --port 5173 --strictPort"
      ],
      "port": 5173
    }
  ]
}
