{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "flyborne",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "flyborne",
        "run",
        "dev"
      ],
      "port": 5191
    },
    {
      "name": "flyborne-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "flyborne",
        "run",
        "server"
      ],
      "port": 8791
    },
    {
      "name": "docs",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8090",
        "--directory",
        "docs"
      ],
      "port": 8090
    }
  ]
}