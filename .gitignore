# Python
.venv/
__pycache__/
*.pyc

# Connectome data and built network (downloaded/built by flybrain/build.py, ~1.3 GB)
fly-data/
*.npz
*.feather

# Per-match logs and reservoir recordings written by fly_fighter.py
logs/
recordings*/
readout.npz

# Private planning notes
ROADMAP.md

# Never commit SSH keys or API tokens
*.pem
id_*
sshfighter-*
.env

# Vercel build output (docs/ + the built simulator, assembled at deploy time)
.vercel-out/
.vercel/

# Flybook app
flybook/worker/data/
flybook/web/node_modules/
flybook/web/dist/
flybook/web/.env.local
flybook/supabase/.temp/
flybook/supabase/.branches/
# the translator is small and the worker image needs it
!flybook/worker/model/translator.npz

# Fly Radio: same reasoning -- the caption readout is small and a deployed machine needs it
# cached so a cold start doesn't have to recalibrate from scratch (radio/decode.py)
!radio/model/readout.npz

# Python packaging
dist/
build/
*.egg-info/

# every env file stays local (only the example is committed)
.env.*
!.env.example
!**/.env.example

# billboard ad drafts (local only)
billboard/

# Fly trading (real money): closed source, lives in its own private repo
flytrade/

.vercel
.env*

# private game repo (its own git)
game/
