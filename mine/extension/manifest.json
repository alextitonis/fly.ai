{
  "manifest_version": 3,
  "name": "fly.ai compute",
  "version": "0.3.0",
  "description": "Lend your GPU or CPU to fruit-fly brain research while you browse. Off until you turn it on.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "fly.ai compute",
    "default_popup": "mine/extension/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "background": {
    "service_worker": "mine/extension/background.js",
    "type": "module"
  },
  "permissions": [
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "https://flyai-mine.fly.dev/*",
    "http://localhost:8787/*",
    "https://*.flyaiworld.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
