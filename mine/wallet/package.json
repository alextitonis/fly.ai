{
  "name": "fly-mine-wallet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "wagmi for the compute pages, bundled into one browser module (the pages have no bundler of their own)",
  "scripts": {
    "build": "node build.mjs && npm run types",
    "types": "tsc -p tsconfig.json --noEmit false --declaration --emitDeclarationOnly --outDir ../web/wallet",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@wagmi/connectors": "^8.2.0",
    "@wagmi/core": "^3.6.5",
    "@walletconnect/ethereum-provider": "^2.25.0",
    "esbuild": "^0.28.2",
    "typescript": "5.9",
    "viem": "^2.56.7"
  }
}
