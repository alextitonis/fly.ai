# Hermes Environment Configuration
# Copy this file to .env and set your values

# Gateway Configuration
PASSPHRASE=your-secure-passphrase-here
LOG_LEVEL=info
PORT=15888

# API Configuration
JUPITER_API_KEY=your-jupiter-api-key
HELius_API_KEY=your-helius-api-key
ETHERSCAN_API_KEY=your-etherscan-api-key
COINGECKO_API_KEY=your-coingecko-api-key
DEFILLAMA_API_KEY=your-defillama-api-key

# Network Configuration
SOLANA_RPC_PROVIDER=https://api.mainnet-beta.solana.com
ETHEREUM_RPC_PROVIDER=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Database Configuration
DATABASE_URL=sqlite:///~/.hermes/hermes.db

# Trading Configuration
TRADING_ENABLED=true
DRY_RUN_ENABLED=false
MAX_SLIPPAGE=0.02
GAS_PRICE_LIMIT=100

# Monitoring Configuration
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging Configuration
LOG_TO_STDOUT=true
LOG_FILE_PATH=~/.hermes/logs/hermes.log