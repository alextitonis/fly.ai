{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"],
    "outDir": "dist-scripts",
    "resolveJsonModule": true
  },
  "include": ["scripts/**/*.ts"]
}
