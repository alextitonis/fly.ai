# loxley · copy to .env next to the package (or in the directory you run it from), or leave it: every value below is the default.
# keep .env out of git. it is in .gitignore already.

# ---------- the wallet ----------
# three ways in, checked in this order. leave all three empty and loxley reads only.
#   1. a private key (0x + 64 hex characters)
#   2. a seed phrase (12 to 24 words) plus the account index on m/44'/60'/0'/0/<index>
#   3. nothing here, and `loxley wallet import` puts the secret in an encrypted keystore at ~/.loxley/wallet.json
#      (scrypt + aes-256-gcm). the passphrase is asked on the terminal; LOXLEY_PASSPHRASE answers it for servers and bots.
# a burner with what one session may lose is the whole idea. the main stack stays in a wallet loxley never sees.
PRIVATE_KEY=
MNEMONIC=
MNEMONIC_INDEX=0
LOXLEY_PASSPHRASE=
# where the keystore, the book (positions.json) and the router state live; empty means ~/.loxley
LOXLEY_HOME=

# ---------- live trading ----------
# what `snipe --live` fires per launch, the most it deploys in one session, how many positions it holds at once
LIVE_ETH=0.005
LIVE_BUDGET_ETH=0.02
LIVE_MAX_OPEN=2
# every buy and sell reverts if it would fill worse than the quote by more than this (basis points, 300 = 3%)
SLIPPAGE_BPS=300
# gas: the simulated estimate times this, and how long to wait for a receipt
GAS_MULTIPLIER=1.2
TX_TIMEOUT_MS=90000

# ---------- the sniper's rules, paper and live alike ----------
PAPER_ETH=0.01
MIN_SCORE=70
MAX_OPEN=3
# the opening tax the draw waits for (bps), and how long it waits before passing
TAX_CEILING_BPS=300
DRAW_MAX_S=20
MAX_DEV_SHARE=8
MAX_CREATOR_TAX=3
ETH_PAIRS_ONLY=1
MAX_TWINS=1
# the bundle rules. MAX_EXEMPT: how many snipe-tax-exempt wallets a launch may declare in launchAndBuy (0 = none: a
# declared bundle is a pass). MAX_BUNDLE_PCT: the share of supply taken in the launch block by wallets other than the
# deployer; above it the desk passes. REQUIRE_SOCIALS=1 passes launches whose getTokenInfo carries no link at all.
# REFUSE_FARMS=1 passes a launch whose fingerprint (dev buy to the wei, creator tax, links) matches other deployers
# inside the last 30 minutes: a launch farm, one operator behind many wallets.
MAX_EXEMPT=0
MAX_BUNDLE_PCT=8
REQUIRE_SOCIALS=0
REFUSE_FARMS=1
# exits: take profit, stop loss, trailing stop below the peak (armed once the position is +10%), max hold; marks every N seconds.
# the dev-sold siren (the deployer's tokens leaving its wallet, or a CurveSell by it) closes a position whatever the p&l.
TAKE_PROFIT_PCT=80
STOP_LOSS_PCT=35
TRAILING_PCT=25
MAX_HOLD_MIN=45
MARK_EVERY_S=5

# ---------- alerts ----------
# every FIRE, CLOSED, SIREN and WAIT of snipe, follow and watch --guard goes to a telegram chat and/or a discord webhook.
# telegram: talk to @BotFather for a token, add the bot to a chat, take the chat id from getUpdates. both empty = off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK=

# ---------- links ----------
# every card ends with the token on pons, axiom and fomo, and the header carries sign-up links with these handles.
# your own handles go here; an empty value drops that sign-up link.
REF_AXIOM=shmidtqq
REF_FOMO=shmidtqq

# ---------- where the chain is ----------
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# the web explorer a person clicks: every link the terminal prints is built from this
EXPLORER_URL=https://robinhoodchain.blockscout.com
# the rest api the terminal reads, which is a different host: blockscout serves this chain's api from
# api.blockscout.com behind a key. Set EXPLORER_URL to your own blockscout (or to test/mock-chain.js) and the
# api follows it, so nothing self-hosted needs this line at all.
EXPLORER_API=https://api.blockscout.com/4663
# a free key at dev.blockscout.com (5 requests a second, ~5000 calls a day). Without it the explorer api answers
# 403 and the deployer x-ray, the transaction counts and the token page read n/a; the chain, the curves, the
# scores and every trade are unaffected.
EXPLORER_API_KEY=
# how far apart calls to that api are handed out, to stay inside the free tier's five a second
EXPLORER_SPACING_MS=220
DEX_URL=https://api.dexscreener.com
CHAIN_ID=4663
CHAIN_SLUG=robinhood

# ---------- pons v2 (docs.ponsfamily.com/v2) and uniswap v4 on Robinhood Chain ----------
FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
LAUNCH_ROUTER=0xe33E9E479dF8802cb0866d5d05258bEc4cF62948
LAUNCH_DEPLOYER=0x3711ceA4feaDE896C913C68F01Eda97Cb06D1A42
PONS_HOOK=0xE5e702641Ea86F4ae6cC3cDaeD2B886f976Be044
# the fee escrow: creator fees from the curve and the pool land here; `fees`, `claim` and `wallet` read it
PONS_ESCROW=0xd3AFEB2a57f70eF218Aa82451c51B2fb0416Ac9e
UNIVERSAL_ROUTER=0x8876789976decbfcbbbe364623c63652db8c0904
V4_QUOTER=0x8dc178efb8111bb0973dd9d722ebeff267c98f94
V4_STATE_VIEW=0xf3334192d15450cdd385c8b70e03f9a6bd9e673b
V4_POOL_MANAGER=0x8366a39cc670b4001a1121b8f6a443a643e40951
PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3
WETH=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
MULTICALL3=0xcA11bde05977b3631167028862bE2a173976CA11

# the virtual quote reserve behind a fresh curve, used only when getReserves() does not answer; the exact figure is read from the curve otherwise
PHANTOM_ETH=1.68

# ---------- the feed and the rpc gate ----------
WINDOW_BLOCKS=12000
POLL_MS=500
RPC_SPACING_MS=60
RPC_LOGS_SPACING_MS=400
LOGS_CHUNK=1000
HTTP_TIMEOUT_MS=9000
# what the explorer and dexscreener see as the client. empty sends loxley/<version>; set your own if a host
# in front of the explorer refuses it (a 403 on a vpn exit is the usual reason)
HTTP_USER_AGENT=
