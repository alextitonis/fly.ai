# Copy to .env and edit. Never share .env: it holds your private key.

# --- network ---------------------------------------------------------------------------------------------
# Testnet (works now): https://testnet-rpc.elysium.kinetiq.xyz  (chain 99801)
# Mainnet (Nov 9): take the RPC ONLY from Kinetiq's docs: https://elysium.kinetiq.xyz/docs/connecting-to-elysium
# A provider key (Alchemy, QuickNode, Chainstack...) is much faster and steadier than the shared public RPC.
RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz

# Wrapped HYPE. Leave empty on testnet (known). On mainnet, set it from Kinetiq's "Contract addresses" page;
# without it only v4 pools paired with native HYPE are traded.
WHYPE=

# Optional: only trade pools made by these factories / PoolManagers (comma separated). Empty = any.
ALLOW_FACTORIES=

# --- wallet (live mode only) -----------------------------------------------------------------------------
# Use a NEW wallet holding only what you are ready to lose. Paper mode does not need a key.
PRIVATE_KEY=

# --- sizing (HYPE) ---------------------------------------------------------------------------------------
BUY_HYPE=0.5
MAX_OPEN=4
MAX_SPEND_HYPE=5
GAS_RESERVE_HYPE=0.05
MAX_BUYS_PER_HOUR=12
PAPER_BALANCE_HYPE=10

# --- entry gates -----------------------------------------------------------------------------------------
MAX_POOL_AGE_SEC=300
MAX_ROUNDTRIP_LOSS_PCT=12
MAX_IMPACT_PCT=8
MIN_TAX_RATIO=0.9

# --- exits -----------------------------------------------------------------------------------------------
TP_X=2
TP_PART=0.5
TRAIL_PCT=25
TRAIL_ARM_X=1.3
STOP_PCT=40
MAX_HOLD_MIN=30
SLIPPAGE_PCT=8
RECHECK_SEC=15

# --- loop ------------------------------------------------------------------------------------------------
POLL_MS=1000
LOOKBACK_BLOCKS=3000
