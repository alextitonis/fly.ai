{
  "name": "fly-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:radio": "tsc --noEmit && vite build --config vite.radio.config.ts",
    "build:roulette": "tsc --noEmit && vite build --config vite.roulette.config.ts",
    "build:slots": "tsc --noEmit && vite build --config vite.slots.config.ts",
    "build:race": "tsc --noEmit && vite build --config vite.race.config.ts",
    "build:flinder": "tsc --noEmit && vite build --config vite.flinder.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
